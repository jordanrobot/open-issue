<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenIssue.Core\OpenIssue.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>issue</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>issue</ToolCommandName>
    <PackageId>OpenIssue.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Open Issue contributors</Authors>
    <Description>Local-first Markdown issue and specification manager.</Description>
    <PackageTags>issue;markdown;offline</PackageTags>
    <RepositoryUrl>https://github.com/jordanrobot/free-issue</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup>
    <DesktopProjectPath>$(MSBuildThisFileDirectory)..\OpenIssue.Desktop\OpenIssue.Desktop.csproj</DesktopProjectPath>
    <DesktopOutputDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\bin\OpenIssue.Desktop\$(Configuration)\net10.0-windows\</DesktopOutputDirectory>
  </PropertyGroup>

  <Target Name="BuildDesktopApplicationForToolPackage" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="The OpenIssue.Tool package includes a Windows desktop application and must be packed on Windows." />
    <MSBuild Projects="$(DesktopProjectPath)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RestoreLockedMode=true" />
    <Error Condition="!Exists('$(DesktopOutputDirectory)OpenIssue.Desktop.exe')"
           Text="The Windows desktop application was not built to '$(DesktopOutputDirectory)'." />
    <ItemGroup>
      <None Include="$(DesktopOutputDirectory)*"
            Pack="true"
            PackagePath="tools/net10.0/any/desktop/" />
    </ItemGroup>
  </Target>

</Project>
