<Window x:Class="OpenIssue.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Issue" Height="760" Width="1120" MinHeight="540" MinWidth="820"
        Activated="Window_Activated">
    <Window.Resources>
        <ContextMenu x:Key="IssueContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Delete issue" Click="DeleteIssue_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Margin="0,0,0,8" Padding="6" ToolTip="Search title, tags, and issue body"
                     TextChanged="Filter_Changed" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="StatusFilter" Width="110" Margin="0,0,6,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="all status" IsSelected="True" />
                    <ComboBoxItem Content="open" />
                    <ComboBoxItem Content="closed" />
                    <ComboBoxItem Content="declined" />
                </ComboBox>
                <ComboBox x:Name="PriorityFilter" Width="100" Margin="0,0,6,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="all priority" IsSelected="True" />
                    <ComboBoxItem Content="urgent" />
                    <ComboBoxItem Content="high" />
                    <ComboBoxItem Content="normal" />
                    <ComboBoxItem Content="low" />
                </ComboBox>
                <CheckBox x:Name="ReadyFilter" Content="Ready only" VerticalAlignment="Center" Checked="Filter_Changed"
                          Unchecked="Filter_Changed" />
            </StackPanel>
            <ListBox x:Name="IssueList" Grid.Row="2" SelectionChanged="IssueList_SelectionChanged"
                     DisplayMemberPath="Title">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu" Value="{StaticResource IssueContextMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="New issue" Padding="10,5" Click="NewIssue_Click" />
                <Button Content="Refresh" Padding="10,5" Margin="8,0,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="TitleBox" Grid.Row="0" FontSize="20" Padding="6" Margin="0,0,0,8"
                     TextChanged="Editor_Changed" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="StatusBox" Width="100" Margin="0,0,12,0" SelectionChanged="Editor_Changed">
                    <ComboBoxItem Content="open" />
                    <ComboBoxItem Content="closed" />
                    <ComboBoxItem Content="declined" />
                </ComboBox>
                <TextBlock Text="Priority" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="PriorityBox" Width="100" Margin="0,0,12,0" SelectionChanged="Editor_Changed">
                    <ComboBoxItem Content="urgent" />
                    <ComboBoxItem Content="high" />
                    <ComboBoxItem Content="normal" />
                    <ComboBoxItem Content="low" />
                </ComboBox>
                <CheckBox x:Name="DraftBox" Content="Draft" IsChecked="True" VerticalAlignment="Center"
                          Checked="Editor_Changed" Unchecked="Editor_Changed" />
            </StackPanel>
            <TextBox x:Name="TagsBox" Grid.Row="2" Padding="6" Margin="0,0,0,8"
                     ToolTip="Comma-separated tags" TextChanged="Editor_Changed" />
            <TextBox x:Name="BodyBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Padding="8" TextChanged="Editor_Changed" />
            <TextBlock x:Name="MessageText" Grid.Row="4" Margin="0,8" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
