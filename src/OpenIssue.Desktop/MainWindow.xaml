<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenIssue.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:OpenIssue.Desktop">
    <Grid x:Name="RootGrid" Margin="16" Background="Transparent" Loaded="Window_Loaded">
        <Grid.Resources>
            <Thickness x:Key="TreeViewItemPresenterMargin">4,0</Thickness>
            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
            <x:Double x:Key="TreeViewItemMinHeight">28</x:Double>
            <Style x:Key="IssueBodyTagHighlightStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="MarkdownToolbarAppBarButtonStyle" TargetType="AppBarButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="IssueListColumn" Width="360" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="IssueDetailsColumn" Width="320" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="IssueListPane"
            Grid.Column="0"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="IssueListHeading"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontSize="20"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="CollapseIssueListButton"
                        x:Uid="CollapseIssueListButton"
                        Grid.Column="1"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="CollapseIssueList_Click"
                        AutomationProperties.AutomationId="CollapseIssueListButton">
                        <FontIcon
                            Glyph="&#xE76B;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14" />
                    </Button>
                </Grid>
                <Expander
                    x:Name="IssueFiltersExpander"
                    x:Uid="IssueFiltersExpander"
                    Grid.Row="1"
                    IsExpanded="False"
                    MinHeight="40"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,0,0,4"
                    AutomationProperties.AutomationId="IssueFiltersExpander">
                    <StackPanel Spacing="4">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            x:Uid="SearchBox"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="SearchBox_TextChanged"
                            AutomationProperties.AutomationId="SearchIssues"
                            AutomationProperties.Name="{x:Bind ViewModel.SearchBoxAutomationName, Mode=OneTime}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                x:Name="StatusFilter"
                                x:Uid="StatusFilter"
                                Width="136"
                                ItemsSource="{x:Bind ViewModel.StatusFilterOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                                SelectionChanged="Filter_Changed"
                                AutomationProperties.AutomationId="StatusFilter">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:FilterChoice">
                                        <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                x:Name="PriorityFilter"
                                x:Uid="PriorityFilter"
                                Width="136"
                                ItemsSource="{x:Bind ViewModel.PriorityFilterOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedPriorityFilter, Mode=TwoWay}"
                                SelectionChanged="Filter_Changed"
                                AutomationProperties.AutomationId="PriorityFilter">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:FilterChoice">
                                        <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox
                            x:Name="DraftOnlyFilter"
                            x:Uid="DraftOnlyFilter"
                            IsChecked="{x:Bind ViewModel.DraftOnly, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Checked="Filter_Changed"
                            Unchecked="Filter_Changed"
                            AutomationProperties.AutomationId="DraftOnlyFilter" />
                    </StackPanel>
                </Expander>
                <Grid Grid.Row="2">
                    <TreeView
                        x:Name="IssueList"
                        ItemsSource="{x:Bind ViewModel.Issues.RootItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedIssueListItem, Mode=OneWay}"
                        SelectionChanged="IssueList_SelectionChanged"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        Margin="-12,0,0,0"
                        DragItemsStarting="IssueList_DragItemsStarting"
                        DragItemsCompleted="IssueList_DragItemsCompleted"
                        DragOver="IssueList_DragOver"
                        Background="Transparent"
                        AutomationProperties.HelpText="{x:Bind ViewModel.IssueListDragDropDescription, Mode=OneTime}"
                        AutomationProperties.AutomationId="IssueList"
                        AutomationProperties.Name="{x:Bind ViewModel.IssueListAutomationName, Mode=OneTime}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:IssueListItem">
                                <TreeViewItem
                                    ItemsSource="{x:Bind Children, Mode=OneWay}"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    Margin="{x:Bind local:MainWindow.CompactNestedRowMargin(Depth), Mode=OneWay}"
                                    AllowDrop="True"
                                    PointerPressed="IssueListItem_PointerPressed"
                                    PointerReleased="IssueListItem_PointerReleased"
                                    DragOver="IssueListItem_DragOver"
                                    DragLeave="IssueListItem_DragLeave"
                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}">
                                    <Grid Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListMoveToRootContextMenuItem"
                                                    Click="MoveIssueToRootContextMenuItem_Click"
                                                    IsEnabled="{x:Bind IsNested, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind MoveToRootAutomationId, Mode=OneTime}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListDuplicateContextMenuItem"
                                                    Click="DuplicateIssueContextMenuItem_Click"
                                                    AutomationProperties.AutomationId="IssueListDuplicateContextMenuItem" />
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListExternalEditContextMenuItem"
                                                    Click="EditIssueExternallyContextMenuItem_Click"
                                                    AutomationProperties.AutomationId="IssueListExternalEditContextMenuItem" />
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListRevealInExplorerContextMenuItem"
                                                    Click="RevealIssueInExplorerContextMenuItem_Click"
                                                    AutomationProperties.AutomationId="IssueListRevealInExplorerContextMenuItem" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListDeleteContextMenuItem"
                                                    Click="DeleteIssueContextMenuItem_Click"
                                                    AutomationProperties.AutomationId="IssueListDeleteContextMenuItem" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Border
                                            Margin="2,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="{x:Bind local:MainWindow.DropTargetBorderThickness(DropHint), Mode=OneWay}">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="1"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind local:MainWindow.NestedIssueVisibility(IsNested), Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Border
                                            Height="2"
                                            Margin="2,0"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropBeforeVisibility(DropHint), Mode=OneWay}" />
                                        <Border
                                            Height="2"
                                            Margin="2,0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropAfterVisibility(DropHint), Mode=OneWay}" />
                                        <Border
                                            Margin="2,0"
                                            CornerRadius="4"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropNestVisibility(DropHint), Mode=OneWay}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Border
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind local:MainWindow.EmptyStateVisibility(ViewModel.Issues.Count, ViewModel.IsRefreshing), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="IssueListEmptyTitle"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Uid="IssueListEmptyDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="NewIssueButton"
                        x:Uid="NewIssueButton"
                        Click="NewIssue_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="NewIssueButton" />
                    <Button
                        x:Name="RefreshButton"
                        x:Uid="RefreshButton"
                        Click="Refresh_Click"
                        AutomationProperties.AutomationId="RefreshIssuesButton" />
                    <Button
                        x:Name="DeleteIssueButton"
                        x:Uid="DeleteIssueButton"
                        Click="DeleteIssue_Click"
                        IsEnabled="{x:Bind ViewModel.IsDeleteEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="DeleteIssueButton" />
                    <Button
                        x:Name="AppearanceSettingsButton"
                        x:Uid="AppearanceSettingsButton"
                        Width="32"
                        Height="32"
                        MinWidth="32"
                        MinHeight="32"
                        Padding="0"
                        AutomationProperties.AutomationId="AppearanceSettingsButton">
                        <Button.Flyout>
                            <Flyout>
                                <Border Padding="12">
                                    <StackPanel Width="240" Spacing="8">
                                        <TextBlock
                                            x:Uid="AppearanceSettingsHeading"
                                            Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ComboBox
                                            x:Name="ColorThemeSelector"
                                            x:Uid="ColorThemeSelector"
                                            Width="240"
                                            SelectedValuePath="Tag"
                                            SelectionChanged="ColorThemeSelector_SelectionChanged"
                                            AutomationProperties.AutomationId="ColorThemeSelector">
                                            <ComboBoxItem x:Uid="ColorThemeSystemOption" Tag="System" />
                                            <ComboBoxItem x:Uid="ColorThemeLightOption" Tag="Light" />
                                            <ComboBoxItem x:Uid="ColorThemeDarkOption" Tag="Dark" />
                                            <ComboBoxItem x:Uid="ColorThemeDraculaOption" Tag="Dracula" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon
                            Glyph="&#xE713;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border
            x:Name="CollapsedIssueListRail"
            Grid.Column="0"
            Padding="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="CollapsedIssueListRail">
            <Button
                x:Name="ExpandIssueListButton"
                x:Uid="ExpandIssueListButton"
                Width="24"
                Height="24"
                MinWidth="24"
                MinHeight="24"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="ExpandIssueList_Click"
                AutomationProperties.AutomationId="ExpandIssueListButton">
                <FontIcon
                    Glyph="&#xE76C;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14" />
            </Button>
        </Border>
        <Border
            x:Name="IssueListDivider"
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <controls:GridSplitter
            x:Name="IssueListSplitter"
            Grid.Column="1"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Auto"
            AutomationProperties.AutomationId="IssueListSplitter"
            AutomationProperties.Name="{x:Bind ViewModel.IssueListSplitterAutomationName, Mode=OneTime}">
            <controls:GridSplitter.RenderTransform>
                <TranslateTransform X="-6" />
            </controls:GridSplitter.RenderTransform>
        </controls:GridSplitter>
        <Border
            Grid.Column="2"
            Padding="24"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,16">
                    <TextBlock
                        x:Uid="IssueContentsHeading"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontSize="20" />
                </StackPanel>
                <TextBox
                    x:Name="TitleBox"
                    x:Uid="TitleBox"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Text="{x:Bind ViewModel.IssueTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="Editor_Changed"
                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="IssueTitle" />
                <CommandBar
                    x:Name="MarkdownFormattingCommandBar"
                    x:Uid="MarkdownFormattingCommandBar"
                    Grid.Row="2"
                    DefaultLabelPosition="Collapsed"
                    HorizontalAlignment="Left"
                    Padding="0"
                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="MarkdownFormattingCommandBar">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            x:Uid="MarkdownUndoButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="MarkdownUndoButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE7A7;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownRedoButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="MarkdownRedoButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE7A6;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator Width="8" />
                        <AppBarButton
                            x:Uid="MarkdownHeadingButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownHeading_Click"
                            AutomationProperties.AutomationId="MarkdownHeadingButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="H"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    FontFamily="Segoe UI" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownBoldButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownBold_Click"
                            AutomationProperties.AutomationId="MarkdownBoldButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="B"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    FontFamily="Segoe UI" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownItalicButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownItalic_Click"
                            AutomationProperties.AutomationId="MarkdownItalicButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="I"
                                    FontSize="16"
                                    FontStyle="Italic"
                                    FontFamily="Segoe UI" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownLinkButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownLink_Click"
                            AutomationProperties.AutomationId="MarkdownLinkButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE71B;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator Width="8" />
                        <AppBarButton
                            x:Uid="MarkdownBulletedListButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownBulletedList_Click"
                            AutomationProperties.AutomationId="MarkdownBulletedListButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE8FD;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownNumberedListButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownNumberedList_Click"
                            AutomationProperties.AutomationId="MarkdownNumberedListButton">
                            <AppBarButton.Icon>
                                <PathIcon
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Data="M2,0 L4,0 L4,4.4 L5,4.4 L5,5.2 L1,5.2 L1,4.4 L2.7,4.4 L2.7,1.6 L1.6,2.5 L1,1.7 Z
                                          M0.7,6.6 C0.7,5.7 1.5,5.3 2.9,5.3 C4.3,5.3 5.1,6.1 5.1,7.1 C5.1,7.9 4.6,8.4 3.8,9.1 L2,10.5 L5.2,10.5 L5.2,11.3 L0.6,11.3 L0.6,10.4 L3.1,8.2 C3.7,7.7 3.9,7.4 3.9,7 C3.9,6.5 3.6,6.2 2.9,6.2 C2.2,6.2 1.8,6.5 1.8,7.1 Z
                                          M0.8,12.2 L1.2,11.5 L3.4,11.5 C4.6,11.5 5.2,12.1 5.2,13 C5.2,13.6 4.9,14 4.3,14.2 C5,14.4 5.4,14.9 5.4,15.5 C5.4,16.4 4.6,17 3.3,17 L1.2,17 L0.7,16.2 L3.2,16.2 C3.8,16.2 4.1,16 4.1,15.6 C4.1,15.2 3.8,15 3.1,15 L1.8,15 L1.8,14 L3.1,14 C3.7,14 4,13.8 4,13.3 C4,12.9 3.7,12.7 3.1,12.7 L0.8,12.7 Z
                                          M7,2.1 L16,2.1 L16,3.1 L7,3.1 Z
                                          M7,8.1 L16,8.1 L16,9.1 L7,9.1 Z
                                          M7,14 L16,14 L16,15 L7,15 Z" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownCheckboxListButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownCheckboxList_Click"
                            AutomationProperties.AutomationId="MarkdownCheckboxListButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE739;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator Width="8" />
                        <AppBarButton
                            x:Uid="MarkdownIndentButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownIndent_Click"
                            AutomationProperties.AutomationId="MarkdownIndentButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE8E3;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            x:Uid="MarkdownOutdentButton"
                            Style="{StaticResource MarkdownToolbarAppBarButtonStyle}"
                            Click="MarkdownOutdent_Click"
                            AutomationProperties.AutomationId="MarkdownOutdentButton">
                            <AppBarButton.Icon>
                                <FontIcon
                                    Glyph="&#xE8E2;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
                <Grid Grid.Row="3">
                    <Canvas
                        x:Name="BodyHighlightCanvas"
                        IsHitTestVisible="False" />
                    <TextBox
                        x:Name="BodyBox"
                        x:Uid="BodyBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Background="Transparent"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Text="{x:Bind ViewModel.IssueBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="BodyBox_TextChanged"
                        SelectionChanged="BodyBox_SelectionChanged"
                        PreviewKeyDown="BodyBox_KeyDown"
                        Loaded="BodyBox_Loaded"
                        ActualThemeChanged="BodyBox_ActualThemeChanged"
                        SizeChanged="BodyBox_SizeChanged"
                        IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="IssueBody" />
                </Grid>
                <StackPanel
                    Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Width="16"
                        Height="16"
                        AutomationProperties.AutomationId="IssueListLoading"
                        AutomationProperties.Name="{x:Bind ViewModel.LoadingAutomationName, Mode=OneTime}" />
                    <TextBlock
                        x:Name="MessageText"
                        Text="{x:Bind ViewModel.DisplayStatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            x:Name="IssueDetailsDivider"
            Grid.Column="3"
            Width="1"
            HorizontalAlignment="Center"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <controls:GridSplitter
            x:Name="IssueDetailsSplitter"
            Grid.Column="3"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Auto"
            AutomationProperties.AutomationId="IssueDetailsSplitter"
            AutomationProperties.Name="{x:Bind ViewModel.IssueDetailsSplitterAutomationName, Mode=OneTime}">
            <controls:GridSplitter.RenderTransform>
                <TranslateTransform X="-6" />
            </controls:GridSplitter.RenderTransform>
        </controls:GridSplitter>
        <Border
            x:Name="IssueDetailsPane"
            Grid.Column="4"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="IssueDetailsPaneHeading"
                            Style="{StaticResource TitleTextBlockStyle}"
                            FontSize="20"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="CollapseIssueDetailsButton"
                            x:Uid="CollapseIssueDetailsButton"
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="CollapseIssueDetails_Click"
                            AutomationProperties.AutomationId="CollapseIssueDetailsButton">
                            <FontIcon
                                Glyph="&#xE76C;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="MetadataText"
                        Text="{x:Bind ViewModel.MetadataText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons
                        x:Name="StatusBox"
                        x:Uid="StatusBox"
                        MaxColumns="3"
                        ItemsSource="{x:Bind ViewModel.IssueStatusOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedIssueStatus, Mode=TwoWay}"
                        SelectionChanged="Editor_Changed"
                        IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="IssueStatus">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate x:DataType="local:FilterChoice">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">
                        <ComboBox
                            x:Name="PriorityBox"
                            x:Uid="PriorityBox"
                            Width="160"
                            ItemsSource="{x:Bind ViewModel.IssuePriorityOptions, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedIssuePriority, Mode=TwoWay}"
                            SelectionChanged="Editor_Changed"
                            IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="IssuePriority">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:FilterChoice">
                                    <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox
                            x:Name="DraftBox"
                            x:Uid="DraftBox"
                            IsChecked="{x:Bind ViewModel.IsDraft, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Checked="Editor_Changed"
                            Unchecked="Editor_Changed"
                            IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="IssueDraft" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="TagsHeading"
                            FontWeight="SemiBold" />
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.IssueTags, Mode=OneWay}"
                            AutomationProperties.AutomationId="IssueTags">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button
                                        x:Uid="TagPill"
                                        Margin="0,2"
                                        Padding="5,1"
                                        MinHeight="24"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Click="TagPill_Click"
                                        Tag="{x:Bind}"
                                        AutomationProperties.Name="{x:Bind}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <TextBlock Text="{x:Bind}" />
                                            <FontIcon
                                                Glyph="&#xE711;"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <AutoSuggestBox
                            x:Name="TagInput"
                            x:Uid="TagInput"
                            ItemsSource="{x:Bind ViewModel.TagSuggestions, Mode=OneWay}"
                            TextChanged="TagInput_TextChanged"
                            SuggestionChosen="TagInput_SuggestionChosen"
                            QuerySubmitted="TagInput_QuerySubmitted"
                            IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="IssueTagsInput" />
                    </StackPanel>
                    <Border
                        x:Name="ParentIssuesDropTarget"
                        x:Uid="ParentIssuesDropTarget"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        DragOver="ParentIssuesDropTarget_DragOver"
                        DragLeave="IssueRelationshipDropTarget_DragLeave"
                        Drop="ParentIssuesDropTarget_Drop"
                        AutomationProperties.AutomationId="ParentIssuesDropTarget">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="ParentIssuesHeading"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="AddParentIssuesButton"
                                    x:Uid="AddParentIssuesButton"
                                    Grid.Column="1"
                                    Click="AddParentIssuesButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="AddParentIssuesButton" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.NoIssueRelationshipsText, Mode=OneTime}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind local:MainWindow.EmptyRelationshipVisibility(ViewModel.HasParentIssueLinks), Mode=OneWay}" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.ParentIssueLinks, Mode=OneWay}"
                                Visibility="{x:Bind local:MainWindow.RelationshipItemsVisibility(ViewModel.HasParentIssueLinks), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IssueRelationshipLink">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                x:Uid="RelatedIssueButton"
                                                Margin="0,2"
                                                Padding="5,2"
                                                MinHeight="24"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Content="{x:Bind Label, Mode=OneTime}"
                                                Tag="{x:Bind Id, Mode=OneTime}"
                                                Click="RelatedIssue_Click"
                                                AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                            <Button
                                                x:Uid="RemoveParentRelationshipButton"
                                                Width="24"
                                                Height="24"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Padding="0"
                                                Tag="{x:Bind Id, Mode=OneTime}"
                                                Click="RemoveParentRelationshipButton_Click"
                                                ToolTipService.ToolTip="{x:Bind local:MainWindow.FormatParentRelationshipRemovalName(Label), Mode=OneTime}"
                                                AutomationProperties.Name="{x:Bind local:MainWindow.FormatParentRelationshipRemovalName(Label), Mode=OneTime}"
                                                AutomationProperties.AutomationId="{x:Bind local:MainWindow.ParentRelationshipRemovalAutomationId(Id), Mode=OneTime}">
                                                <FontIcon
                                                    Glyph="&#xE711;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="ChildIssuesDropTarget"
                        x:Uid="ChildIssuesDropTarget"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        DragOver="ChildIssuesDropTarget_DragOver"
                        DragLeave="IssueRelationshipDropTarget_DragLeave"
                        Drop="ChildIssuesDropTarget_Drop"
                        AutomationProperties.AutomationId="ChildIssuesDropTarget">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="ChildIssuesHeading"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="AddChildIssuesButton"
                                    x:Uid="AddChildIssuesButton"
                                    Grid.Column="1"
                                    Click="AddChildIssuesButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="AddChildIssuesButton" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.NoIssueRelationshipsText, Mode=OneTime}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind local:MainWindow.EmptyRelationshipVisibility(ViewModel.HasChildIssueLinks), Mode=OneWay}" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.ChildIssueLinks, Mode=OneWay}"
                                Visibility="{x:Bind local:MainWindow.RelationshipItemsVisibility(ViewModel.HasChildIssueLinks), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IssueRelationshipLink">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                x:Uid="RelatedIssueButton"
                                                Margin="0,2"
                                                Padding="5,2"
                                                MinHeight="24"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Content="{x:Bind Label, Mode=OneTime}"
                                                Tag="{x:Bind Id, Mode=OneTime}"
                                                Click="RelatedIssue_Click"
                                                AutomationProperties.Name="{x:Bind Label, Mode=OneTime}" />
                                            <Button
                                                x:Uid="RemoveChildRelationshipButton"
                                                Width="24"
                                                Height="24"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Padding="0"
                                                Tag="{x:Bind Id, Mode=OneTime}"
                                                Click="RemoveChildRelationshipButton_Click"
                                                ToolTipService.ToolTip="{x:Bind local:MainWindow.FormatChildRelationshipRemovalName(Label), Mode=OneTime}"
                                                AutomationProperties.Name="{x:Bind local:MainWindow.FormatChildRelationshipRemovalName(Label), Mode=OneTime}"
                                                AutomationProperties.AutomationId="{x:Bind local:MainWindow.ChildRelationshipRemovalAutomationId(Id), Mode=OneTime}">
                                                <FontIcon
                                                    Glyph="&#xE711;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border
            x:Name="CollapsedIssueDetailsRail"
            Grid.Column="4"
            Padding="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="CollapsedIssueDetailsRail">
            <Button
                x:Name="ExpandIssueDetailsButton"
                x:Uid="ExpandIssueDetailsButton"
                Width="24"
                Height="24"
                MinWidth="24"
                MinHeight="24"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="ExpandIssueDetails_Click"
                AutomationProperties.AutomationId="ExpandIssueDetailsButton">
                <FontIcon
                    Glyph="&#xE76B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14" />
            </Button>
        </Border>
        <Popup
            x:Name="IssueReferenceSuggestionsPopup"
            IsOpen="{x:Bind ViewModel.HasIssueReferenceSuggestions, Mode=OneWay}">
            <Border
                Width="320"
                MaxHeight="144"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView
                    x:Name="IssueReferenceSuggestionsList"
                    MaxHeight="142"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.IssueReferenceSuggestions, Mode=OneWay}"
                    ItemClick="IssueReferenceSuggestionsList_ItemClick"
                    AutomationProperties.AutomationId="IssueReferenceSuggestions"
                    AutomationProperties.Name="{x:Bind ViewModel.IssueReferenceSuggestionsAutomationName, Mode=OneTime}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:IssueListItem">
                            <TextBlock
                                Text="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</Window>
