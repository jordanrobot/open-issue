<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenIssue.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:OpenIssue.Desktop">
    <Grid x:Name="RootGrid" Margin="16" Background="Transparent" Loaded="Window_Loaded">
        <Grid.Resources>
            <Thickness x:Key="TreeViewItemPresenterMargin">4,0</Thickness>
            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
            <x:Double x:Key="TreeViewItemMinHeight">28</x:Double>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="IssueListColumn" Width="360" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="480" />
        </Grid.ColumnDefinitions>
        <Border
            x:Name="IssueListPane"
            Grid.Column="0"
            Padding="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="IssueListHeading"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontSize="20"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="CollapseIssueListButton"
                        x:Uid="CollapseIssueListButton"
                        Grid.Column="1"
                        Width="24"
                        Height="24"
                        MinWidth="24"
                        MinHeight="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="CollapseIssueList_Click"
                        AutomationProperties.AutomationId="CollapseIssueListButton">
                        <FontIcon
                            Glyph="&#xE76B;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14" />
                    </Button>
                </Grid>
                <Expander
                    x:Name="IssueFiltersExpander"
                    x:Uid="IssueFiltersExpander"
                    Grid.Row="1"
                    IsExpanded="False"
                    MinHeight="40"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,0,0,4"
                    AutomationProperties.AutomationId="IssueFiltersExpander">
                    <StackPanel Spacing="4">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            x:Uid="SearchBox"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="SearchBox_TextChanged"
                            AutomationProperties.AutomationId="SearchIssues"
                            AutomationProperties.Name="{x:Bind ViewModel.SearchBoxAutomationName, Mode=OneTime}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <ComboBox
                                x:Name="StatusFilter"
                                x:Uid="StatusFilter"
                                Width="136"
                                ItemsSource="{x:Bind ViewModel.StatusFilterOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                                SelectionChanged="Filter_Changed"
                                AutomationProperties.AutomationId="StatusFilter">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:FilterChoice">
                                        <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                x:Name="PriorityFilter"
                                x:Uid="PriorityFilter"
                                Width="136"
                                ItemsSource="{x:Bind ViewModel.PriorityFilterOptions, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.SelectedPriorityFilter, Mode=TwoWay}"
                                SelectionChanged="Filter_Changed"
                                AutomationProperties.AutomationId="PriorityFilter">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:FilterChoice">
                                        <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox
                            x:Name="DraftOnlyFilter"
                            x:Uid="DraftOnlyFilter"
                            IsChecked="{x:Bind ViewModel.DraftOnly, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Checked="Filter_Changed"
                            Unchecked="Filter_Changed"
                            AutomationProperties.AutomationId="DraftOnlyFilter" />
                    </StackPanel>
                </Expander>
                <Grid Grid.Row="2">
                    <TreeView
                        x:Name="IssueList"
                        ItemsSource="{x:Bind ViewModel.Issues.RootItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedIssueListItem, Mode=OneWay}"
                        SelectionChanged="IssueList_SelectionChanged"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        Margin="-12,0,0,0"
                        DragItemsStarting="IssueList_DragItemsStarting"
                        DragItemsCompleted="IssueList_DragItemsCompleted"
                        DragOver="IssueList_DragOver"
                        Background="Transparent"
                        ToolTipService.ToolTip="{x:Bind ViewModel.IssueListDragDropDescription, Mode=OneTime}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.IssueListDragDropDescription, Mode=OneTime}"
                        AutomationProperties.AutomationId="IssueList"
                        AutomationProperties.Name="{x:Bind ViewModel.IssueListAutomationName, Mode=OneTime}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:IssueListItem">
                                <TreeViewItem
                                    ItemsSource="{x:Bind Children, Mode=OneWay}"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    Margin="{x:Bind local:MainWindow.CompactNestedRowMargin(Depth), Mode=OneWay}"
                                    AllowDrop="True"
                                    PointerPressed="IssueListItem_PointerPressed"
                                    PointerReleased="IssueListItem_PointerReleased"
                                    DragOver="IssueListItem_DragOver"
                                    DragLeave="IssueListItem_DragLeave"
                                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}">
                                    <Grid Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListMoveToRootContextMenuItem"
                                                    Click="MoveIssueToRootContextMenuItem_Click"
                                                    IsEnabled="{x:Bind IsNested, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind MoveToRootAutomationId, Mode=OneTime}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    x:Uid="IssueListDeleteContextMenuItem"
                                                    Click="DeleteIssueContextMenuItem_Click"
                                                    AutomationProperties.AutomationId="IssueListDeleteContextMenuItem" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Border
                                            Margin="2,0"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="{x:Bind local:MainWindow.DropTargetBorderThickness(DropHint), Mode=OneWay}">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="1"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind local:MainWindow.NestedIssueVisibility(IsNested), Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Border
                                            Height="2"
                                            Margin="2,0"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropBeforeVisibility(DropHint), Mode=OneWay}" />
                                        <Border
                                            Height="2"
                                            Margin="2,0"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropAfterVisibility(DropHint), Mode=OneWay}" />
                                        <Border
                                            Margin="2,0"
                                            CornerRadius="4"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind local:MainWindow.DropNestVisibility(DropHint), Mode=OneWay}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Border
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind local:MainWindow.EmptyStateVisibility(ViewModel.Issues.Count, ViewModel.IsRefreshing), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="IssueListEmptyTitle"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Uid="IssueListEmptyDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="NewIssueButton"
                        x:Uid="NewIssueButton"
                        Click="NewIssue_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="NewIssueButton" />
                    <Button
                        x:Name="RefreshButton"
                        x:Uid="RefreshButton"
                        Click="Refresh_Click"
                        AutomationProperties.AutomationId="RefreshIssuesButton" />
                    <Button
                        x:Name="DeleteIssueButton"
                        x:Uid="DeleteIssueButton"
                        Click="DeleteIssue_Click"
                        IsEnabled="{x:Bind ViewModel.IsDeleteEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="DeleteIssueButton" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            x:Name="CollapsedIssueListRail"
            Grid.Column="0"
            Padding="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="CollapsedIssueListRail">
            <Button
                x:Name="ExpandIssueListButton"
                x:Uid="ExpandIssueListButton"
                Width="24"
                Height="24"
                MinWidth="24"
                MinHeight="24"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Click="ExpandIssueList_Click"
                AutomationProperties.AutomationId="ExpandIssueListButton">
                <FontIcon
                    Glyph="&#xE76C;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14" />
            </Button>
        </Border>
        <Border
            x:Name="IssueListDivider"
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <controls:GridSplitter
            x:Name="IssueListSplitter"
            Grid.Column="1"
            Width="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Auto"
            AutomationProperties.AutomationId="IssueListSplitter"
            AutomationProperties.Name="{x:Bind ViewModel.IssueListSplitterAutomationName, Mode=OneTime}">
            <controls:GridSplitter.RenderTransform>
                <TranslateTransform X="-6" />
            </controls:GridSplitter.RenderTransform>
        </controls:GridSplitter>
        <Border
            Grid.Column="2"
            Padding="24"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Spacing="4">
                    <TextBlock
                        x:Uid="IssueDetailsHeading"
                        Style="{StaticResource TitleTextBlockStyle}"
                        FontSize="20" />
                    <TextBlock
                        x:Name="MetadataText"
                        Text="{x:Bind ViewModel.MetadataText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBox
                    x:Name="TitleBox"
                    x:Uid="TitleBox"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Text="{x:Bind ViewModel.IssueTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="Editor_Changed"
                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="IssueTitle" />
                <RadioButtons
                    x:Name="StatusBox"
                    x:Uid="StatusBox"
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    MaxColumns="3"
                    ItemsSource="{x:Bind ViewModel.IssueStatusOptions, Mode=OneTime}"
                    SelectedItem="{x:Bind ViewModel.SelectedIssueStatus, Mode=TwoWay}"
                    SelectionChanged="Editor_Changed"
                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="IssueStatus">
                    <RadioButtons.ItemTemplate>
                        <DataTemplate x:DataType="local:FilterChoice">
                            <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                        </DataTemplate>
                    </RadioButtons.ItemTemplate>
                </RadioButtons>
                <StackPanel
                    Grid.Row="3"
                    Margin="0,0,0,12"
                    Orientation="Horizontal"
                    Spacing="16">
                    <ComboBox
                        x:Name="PriorityBox"
                        x:Uid="PriorityBox"
                        Width="180"
                        ItemsSource="{x:Bind ViewModel.IssuePriorityOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedIssuePriority, Mode=TwoWay}"
                        SelectionChanged="Editor_Changed"
                        IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="IssuePriority">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:FilterChoice">
                                <TextBlock Text="{x:Bind Display, Mode=OneTime}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox
                        x:Name="DraftBox"
                        x:Uid="DraftBox"
                        IsChecked="{x:Bind ViewModel.IsDraft, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Checked="Editor_Changed"
                        Unchecked="Editor_Changed"
                        IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="IssueDraft" />
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    Margin="0,0,0,12"
                    Spacing="8">
                    <TextBox
                        x:Name="TagsBox"
                        x:Uid="TagsBox"
                        Text="{x:Bind ViewModel.IssueTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="Editor_Changed"
                        IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="IssueTags" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.ParentIssuesText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="AddParentIssuesButton"
                            x:Uid="AddParentIssuesButton"
                            Grid.Column="1"
                            Click="AddParentIssuesButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="AddParentIssuesButton" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.ChildIssuesText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="AddChildIssuesButton"
                            x:Uid="AddChildIssuesButton"
                            Grid.Column="1"
                            Click="AddChildIssuesButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                            AutomationProperties.AutomationId="AddChildIssuesButton" />
                    </Grid>
                </StackPanel>
                <ListView
                    x:Name="IssueReferenceSuggestionsList"
                    Grid.Row="5"
                    Margin="0,0,0,8"
                    MaxHeight="144"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.IssueReferenceSuggestions, Mode=OneWay}"
                    ItemClick="IssueReferenceSuggestionsList_ItemClick"
                    Visibility="{x:Bind local:MainWindow.SuggestionVisibility(ViewModel.HasIssueReferenceSuggestions), Mode=OneWay}"
                    AutomationProperties.AutomationId="IssueReferenceSuggestions"
                    AutomationProperties.Name="{x:Bind ViewModel.IssueReferenceSuggestionsAutomationName, Mode=OneTime}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:IssueListItem">
                            <TextBlock
                                Text="{x:Bind local:MainWindowViewModel.FormatIssueLabel(Id, Title), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBox
                    x:Name="BodyBox"
                    x:Uid="BodyBox"
                    Grid.Row="6"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Text="{x:Bind ViewModel.IssueBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="BodyBox_TextChanged"
                    KeyDown="BodyBox_KeyDown"
                    IsEnabled="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay}"
                    AutomationProperties.AutomationId="IssueBody" />
                <StackPanel
                    Grid.Row="7"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Width="16"
                        Height="16"
                        AutomationProperties.AutomationId="IssueListLoading"
                        AutomationProperties.Name="{x:Bind ViewModel.LoadingAutomationName, Mode=OneTime}" />
                    <TextBlock
                        x:Name="MessageText"
                        Text="{x:Bind ViewModel.DisplayStatusMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
