<Window x:Class="FreeIssue.Desktop.NewIssueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New issue" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16" Width="420">
        <TextBlock Text="Issue title" Margin="0,0,0,6" />
        <TextBox x:Name="TitleBox" Padding="6" MinWidth="400" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Create" IsDefault="True" Padding="12,5" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
</Window>
