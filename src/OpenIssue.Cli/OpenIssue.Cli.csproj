<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenIssue.Core\OpenIssue.Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>issue</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>issue</ToolCommandName>
    <PackAsToolShimRuntimeIdentifiers>win-x64</PackAsToolShimRuntimeIdentifiers>
    <PackageId>OpenIssue.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Open Issue contributors</Authors>
    <Description>Local-first Markdown issue and specification manager.</Description>
    <PackageTags>issue;markdown;offline</PackageTags>
    <RepositoryUrl>https://github.com/jordanrobot/free-issue</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Update="skills/manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../.github/skills/implement-issue/**/*">
      <Link>skills/implement-issue/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <DesktopProjectPath>$(MSBuildThisFileDirectory)..\OpenIssue.Desktop\OpenIssue.Desktop.csproj</DesktopProjectPath>
    <DesktopTargetFramework>net10.0-windows10.0.26100.0</DesktopTargetFramework>
    <DesktopRuntimeIdentifier>win-x64</DesktopRuntimeIdentifier>
    <DesktopOutputDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\bin\OpenIssue.Desktop\$(Configuration)\$(DesktopTargetFramework)\$(DesktopRuntimeIdentifier)\</DesktopOutputDirectory>
  </PropertyGroup>

  <Target Name="BuildDesktopApplicationForToolPackage" BeforeTargets="_GetPackageFiles">
    <Error Condition="'$(OS)' != 'Windows_NT'"
           Text="The OpenIssue.Tool package includes a Windows desktop application and must be packed on Windows." />
    <MSBuild Projects="$(DesktopProjectPath)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RestoreLockedMode=true"
             RemoveProperties="RuntimeIdentifier" />
    <Error Condition="!Exists('$(DesktopOutputDirectory)OpenIssue.Desktop.exe')"
           Text="The WinUI desktop application was not built to '$(DesktopOutputDirectory)'." />
    <ItemGroup>
      <WinUiPayload Include="$(DesktopOutputDirectory)**\*"
                    Exclude="$(DesktopOutputDirectory)AppX\**\*;$(DesktopOutputDirectory)Assets\**\*;$(DesktopOutputDirectory)publish\**\*;$(DesktopOutputDirectory)packages.lock.json;$(DesktopOutputDirectory)**\*.pdb">
        <Pack>true</Pack>
        <PackagePath>tools/net10.0/any/desktop/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </WinUiPayload>
      <None Include="@(WinUiPayload)" />
      <WinUiAssets Include="..\OpenIssue.Desktop\Assets\**\*">
        <Pack>true</Pack>
        <PackagePath>tools/net10.0/any/desktop/Assets/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </WinUiAssets>
      <None Include="@(WinUiAssets)" />
      <None Include="..\OpenIssue.Desktop\Package.appxmanifest"
            Pack="true"
            PackagePath="tools/net10.0/any/desktop/Package.appxmanifest" />
    </ItemGroup>
  </Target>

</Project>
